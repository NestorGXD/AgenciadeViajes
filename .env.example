# ==========================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://agenciade-viajes.vercel.app"

# ==========================================
# BASE DE DATOS (Prisma ORM)
# Compatible con PostgreSQL (Neon, Supabase, Vercel Postgres) o MySQL
# ==========================================
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/postgres?schema=public"

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==========================================
JWT_SECRET="super-secreto-cambiar-en-produccion-minimo-32-caracteres-aleatorios"
NEXTAUTH_SECRET="super-secreto-cambiar-en-produccion-minimo-32-caracteres-aleatorios"

# ==========================================
# SERVICIO DE CORREO ELECTRÓNICO (Resend / Nodemailer)
# ==========================================
# Obtén tu API Key gratuita en https://resend.com
RESEND_API_KEY="re_tu_resend_api_key_aqui"
EMAIL_FROM="Contigo Tours <onboarding@resend.dev>"
# Correo donde se reciben los informes de viajes escolares y cotizaciones:
SCHOOL_TRIPS_ADMIN_EMAIL="hugoalex.riverab@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="4431866129"

# ==========================================
# PASARELA DE PAGOS - STRIPE
# Obtén tus llaves de prueba en https://dashboard.stripe.com/test/apikeys
# ==========================================
STRIPE_SECRET_KEY="sk_test_tu_stripe_secret_key_aqui"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_tu_stripe_publishable_key_aqui"
# Obtén el Webhook Secret con `stripe listen --forward-to localhost:3000/api/webhook/stripe`
STRIPE_WEBHOOK_SECRET="whsec_tu_webhook_secret_aqui"

# ==========================================
# PASARELA DE PAGOS ALTERNATIVA - MERCADO PAGO (Opcional)
# ==========================================
MERCADOPAGO_PUBLIC_KEY="TEST-tu_mercadopago_public_key"
MERCADOPAGO_ACCESS_TOKEN="TEST-tu_mercadopago_access_token"

# ==========================================
# ANALÍTICA WEB (Google Analytics 4)
# ==========================================
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
